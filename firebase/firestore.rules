rules_version = '2';

// Porteiro do GameForge Sync. Não existe servidor próprio: app e gfs falam direto
// com o Firestore, então tudo que importa (quem lê, quem grava, versões) é garantido aqui.
service cloud.firestore {
  match /databases/{database}/documents {

    // Só estas contas Google usam o app. Mudou a lista? Atualize também
    // database.rules.json e ALLOWED_EMAILS em app/src/config.ts, e faça o deploy.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        // Google ou link no e-mail (Hotmail etc.: o token do link vem como 'password'),
        // sempre com e-mail verificado.
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'password']
        && request.auth.token.email in [
          'andreluizvillanova123@gmail.com',
          'kaue.bimok@gmail.com',
          'jonatas3dmodel@gmail.com',
          'adriwolf@hotmail.com'
        ];
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isMember(roomId) {
      return signedIn() && request.auth.uid in roomData(roomId).memberIds;
    }

    function isOwner(roomId) {
      return signedIn() && roomData(roomId).ownerId == request.auth.uid;
    }

    function canEdit(roomId) {
      let room = roomData(roomId);
      return signedIn()
        && request.auth.uid in room.memberIds
        && room.roles[request.auth.uid] in ['owner', 'editor'];
    }

    function isAuthor(data) {
      return data.author.uid == request.auth.uid
        && data.author.name is string
        && data.author.kind in ['human', 'claude'];
    }

    // ── salas ──────────────────────────────────────────────────────────────
    match /rooms/{roomId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.roles.size() == 1
        && request.resource.data.roles[request.auth.uid] == 'owner'
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;

      // Dono mexe em tudo (menos trocar o dono); os outros só podem "entrar" com convite válido.
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.roles[resource.data.ownerId] == 'owner')
        || isJoining(roomId)
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      function isJoining(roomId) {
        let uid = request.auth.uid;
        let invite = get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode)).data;
        return !(uid in resource.data.memberIds)
          && invite.roomId == roomId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'names', 'lastJoinCode'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([uid])
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid])
          && request.resource.data.roles[uid] == invite.role
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid]);
      }

      // ── arquivos de código: um documento por arquivo, com versão ──
      match /files/{fileId} {
        allow read: if isMember(roomId);

        allow create: if canEdit(roomId)
          && validFile()
          && request.resource.data.version == 1;

        // Só grava se partiu da versão atual (o merge acontece no cliente antes).
        allow update: if canEdit(roomId)
          && validFile()
          && request.resource.data.path == resource.data.path
          && request.resource.data.version == resource.data.version + 1;

        allow delete: if canEdit(roomId);

        function validFile() {
          let d = request.resource.data;
          return d.keys().hasOnly(['path', 'content', 'version', 'author', 'updatedAt', 'parts', 'size'])
            && (!('parts' in d) || (d.parts is int && d.parts <= 10))
            && d.path is string
            && d.path.size() <= 300
            && d.content is string
            && d.version is int
            && d.updatedAt == request.time
            && isAuthor(d);
        }
      }

      // ── pedaços dos arquivos grandes (> 900 KB): {arquivo}~{n}, cada um com a versão do arquivo ──
      match /blobs/{blobId} {
        allow read: if isMember(roomId);
        allow create, update: if canEdit(roomId)
          && request.resource.data.keys().hasOnly(['path', 'version', 'i', 'data'])
          && request.resource.data.data is string
          && request.resource.data.version is int
          && request.resource.data.i is int;
        allow delete: if canEdit(roomId);
      }

      // ── feed de atividade (só cresce) ──
      match /activity/{eventId} {
        allow read: if isMember(roomId);
        allow delete: if isOwner(roomId);
        allow create: if canEdit(roomId)
          && isAuthor(request.resource.data)
          && request.resource.data.ts == request.time
          && request.resource.data.summary is string
          && request.resource.data.summary.size() <= 300;
      }

      // ── histórico: cada gravação com o conteúdo daquela versão (para ver a diferença e restaurar) ──
      match /history/{entryId} {
        allow read: if isMember(roomId);
        allow create, update: if canEdit(roomId)
          && isAuthor(request.resource.data)
          && request.resource.data.ts == request.time
          && request.resource.data.path is string
          && request.resource.data.content is string
          && request.resource.data.version is int
          && request.resource.data.kind in ['edit', 'create', 'delete', 'restore'];
        allow delete: if isOwner(roomId);
      }

      // ── backups: "foto" do jogo inteiro (arquivo → versão) ──
      match /checkpoints/{cpId} {
        allow read: if isMember(roomId);
        allow create: if canEdit(roomId)
          && request.resource.data.author.uid == request.auth.uid
          && request.resource.data.ts == request.time
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 80
          && request.resource.data.files is map;
        allow delete: if isOwner(roomId);
      }

      // ── builds feitos pelo botão BUILD (para todos verem e baixarem de novo) ──
      match /builds/{buildId} {
        allow read: if isMember(roomId);
        allow create: if canEdit(roomId) && request.resource.data.by.uid == request.auth.uid && request.resource.data.ts == request.time;
        allow update: if canEdit(roomId) && request.resource.data.by == resource.data.by;
        allow delete: if isOwner(roomId);
      }

      // ── imagens temporárias da lista de bugs (somem quando o item é resolvido) ──
      match /bugimgs/{imgId} {
        allow read: if isMember(roomId);
        allow create: if canEdit(roomId)
          && request.resource.data.keys().hasOnly(['data', 'ts'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 800000
          && request.resource.data.ts is int;
        allow delete: if canEdit(roomId);
      }

      // ── reservas de assets (soft locks, salas Unreal; ver app/src/claims.ts) ──
      // UM documento 'assets' com c = {chave: reserva}, para a transação do cliente ver a tabela inteira
      // (sobreposição pasta × arquivo). Cada gravação mexe só na chave k (e pode limpar UMA vencida em g).
      // Ninguém toma reserva ativa de outra pessoa; liberar a de outro só se venceu ou se é o dono da sala.
      match /claims/{claimId} {
        allow read: if isMember(roomId);
        allow create, update: if claimId == 'assets' && canEdit(roomId) && validClaims(roomId);
        allow delete: if isOwner(roomId);

        function validClaims(roomId) {
          let d = request.resource.data;
          let before = resource == null ? {} : resource.data.c;
          let after = d.c;
          let k = d.k;
          let g = d.get('g', k);
          let old = before.get(k, null);
          let mine = after.get(k, null);
          return d.keys().hasOnly(['c', 'k', 'g'])
            && k is string && k.size() > 0 && k.size() <= 300
            && g is string
            && after is map && after.size() <= 500
            && after.diff(before).affectedKeys().hasOnly([k, g])
            && (g == k || !(g in before) || (!(g in after) && before[g].exp < request.time))
            && (old == null || old.uid == request.auth.uid || old.exp < request.time || (mine == null && isOwner(roomId)))
            && (mine == null || validClaim(mine));
        }

        function validClaim(e) {
          return e.keys().hasOnly(['path', 'uid', 'name', 'note', 'exp'])
            && e.uid == request.auth.uid
            && e.path is string && e.path.size() <= 300
            && e.name is string && e.name.size() <= 80
            && e.note is string && e.note.size() <= 200
            && e.exp is timestamp
            && e.exp > request.time
            && e.exp < request.time + duration.value(13, 'h');
        }
      }

      // ── chat da sala (Fase 3) ──
      match /chat/{msgId} {
        allow read: if isMember(roomId);
        allow delete: if isOwner(roomId);
        allow create: if isMember(roomId)
          && isAuthor(request.resource.data)
          && request.resource.data.ts == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000;
      }
    }

    // ── perfis: cada um grava o próprio (nome/e-mail) ao entrar; o dono usa a lista para adicionar gente ──
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
    }

    // ── token da fábrica de builds (fine-grained, só o repo gameforge-builds): só as contas autorizadas leem ──
    match /secrets/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.token.email == 'andreluizvillanova123@gmail.com';
    }

    // ── convites: quem sabe o código consegue ler (mas ninguém consegue listar) ──
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && roomData(request.resource.data.roomId).ownerId == request.auth.uid
        && request.resource.data.role in ['editor', 'viewer'];
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
