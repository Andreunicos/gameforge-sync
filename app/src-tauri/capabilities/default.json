{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Janela principal (tela carregada de https://gameforge-sync.web.app/app/)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "process:allow-restart",
    "allow-google-login",
    "allow-open-with",
    "allow-room-dir",
    "allow-download-asset",
    "allow-write-build-file",
    "allow-reveal-build",
    "allow-rojo-start",
    "allow-rojo-stop",
    "allow-rojo-info",
    "allow-rojo-install",
    "allow-unreal-engines",
    "allow-unreal-open",
    "allow-unreal-server-start",
    "allow-unreal-server-stop",
    "allow-unreal-status",
    "allow-close-guard",
    "allow-app-close"
  ],
  "remote": {
    "urls": [
      "https://gameforge-sync.web.app"
    ]
  }
}
