{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Permissões só do PC: autoatualização e a pasta do Claude (cada pasta de sala é liberada pelo comando room_dir)",
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "updater:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/GameForge"
        },
        {
          "path": "$HOME/GameForge/**"
        }
      ]
    }
  ],
  "remote": {
    "urls": [
      "https://gameforge-sync.web.app"
    ]
  }
}
